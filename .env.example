# Copy this file to .env and fill in the values. Never commit .env.

# Network: "local" (`npx hardhat node`, chain ID 31337) or "glassnet" (Prismo testnet, chain ID 101001000)
NETWORK=local
RPC_URL=http://127.0.0.1:8545
# Glassnet:
# NETWORK=glassnet
# RPC_URL=https://rpc.glassnet.prismo.network

# Deployed CorpusRegistry address (fill in after deploying)
REGISTRY_ADDRESS=

# Wallet private key (needed only to deploy and publish).
# Local: use account #0's key printed by `npx hardhat node`.
# Glassnet: use a testnet-only wallet. Never use a main wallet.
PRIVATE_KEY=

# Ollama running on this laptop
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Retrieval
TOP_K=5
MIN_SIMILARITY=0.35

# Unlocks private document sets in the app. Leave empty to disable private features.
AUDITOR_TOKEN=

EXPLORER_URL=https://explorer.glassnet.prismo.network
